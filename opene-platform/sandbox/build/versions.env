# Låsta versioner för OpenE-sandboxens egen distribution.
# Ändra bara medvetet: uppdatera, bygg, kör `sandboxctl test` och dokumentera i sandbox/README.md.

# Open ePlatform (Git)
OPENE_GIT_URL=https://github.com/Open-ePlatform/Open-ePlatform.git
OPENE_GIT_REF=a34ab2868be5bfcde7ea1be5f4ffd0be4601fba1

# OpenHierarchy (Subversion, endast svn://, port 3690)
OH_SVN=svn://svn.openhierarchy.org/openhierarchy
OH_REV=3190

# Nordic Peak Utils och PureCaptcha (Subversion)
UTILS_SVN=svn://svn.nordicpeak.com/utils
UTILS_REV=1649
PURECAPTCHA_SVN=svn://svn.nordicpeak.com/purecaptcha/trunk
PURECAPTCHA_REV=15

# Runtime
JDK_IMAGE=eclipse-temurin:21-jdk-jammy
JRE_IMAGE=tomcat:9.0.123-jre21-temurin-jammy
MARIADB_IMAGE=mariadb:11.8
MAILPIT_IMAGE=axllent/mailpit:v1.27
MARIADB_CONNECTOR_VERSION=2.7.6
MARIADB_CONNECTOR_SHA256=d3e448b1e8799ccc06c7ad2745aa03e72f19e13124b676b9656a54a833af7a93
