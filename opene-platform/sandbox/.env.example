# Exempel. sandboxctl skapar en riktig .env per instans i ~/.opene-sandbox/instances/<namn>/.env
# med slumpade lösenord. Checka aldrig in en ifylld .env.
SANDBOX_PROJECT=opene-default
SANDBOX_NAME=default
SANDBOX_MODE=persistent
SANDBOX_HTTP_PORT=8480
SANDBOX_MAIL_PORT=8481
OPENE_IMAGE=opene-sandbox:local
DB_PASSWORD=byt-mig
DB_ROOT_PASSWORD=byt-mig
ADMIN_PASSWORD=byt-mig
CITIZEN_PASSWORD=byt-mig
MANAGER_PASSWORD=byt-mig
